{
  "name": "streamdeck-open-apps",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "streamdeck validate com.marclefebvre.openapps.sdPlugin",
    "pack": "streamdeck pack com.marclefebvre.openapps.sdPlugin --output dist --force --no-file-list",
    "media": "node scripts/media.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.25.0",
    "ws": "^8.18.0"
  },
  "description": "A live macOS app switcher for Stream Deck Neo",
  "author": "Marc Lefebvre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lefebma/streamdeck-open-apps.git"
  },
  "bugs": {
    "url": "https://github.com/lefebma/streamdeck-open-apps/issues"
  },
  "homepage": "https://github.com/lefebma/streamdeck-open-apps",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
